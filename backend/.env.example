# Backend Environment Variables Template for Render / Local Development
PORT=5000
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas)
# In Atlas Network Access, make sure to allow IP 0.0.0.0/0
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sports-management?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your-secure-jwt-secret-here

# Gmail SMTP for OTP and Notifications (requires Gmail App Password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password

# Optional fallback OTP for development/testing
MASTER_OTP=987654
